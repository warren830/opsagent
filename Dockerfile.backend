# OpenOps Backend - Multi-stage build
# Supports linux/amd64 and linux/arm64 (Graviton)
# Requires: DOCKER_BUILDKIT=1

# Stage 1: Build Rust binary
FROM public.ecr.aws/docker/library/rust:1.94-slim-bookworm AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Copy manifests first for dependency caching
COPY backend/Cargo.toml backend/Cargo.lock ./

# Build deps only (cache mount persists crates.io index + compiled deps across builds)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    mkdir src && echo "fn main() {}" > src/main.rs \
    && cargo build --release \
    && rm -rf src

# Build actual binary
COPY backend/ .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    touch src/main.rs \
    && cargo build --release \
    && cp target/release/openops /app/openops

# Stage 2: Prepare screener
FROM public.ecr.aws/docker/library/debian:bookworm-slim AS screener

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY .openops/screener* /tmp/screener-check/
RUN if [ -d /tmp/screener-check/global ] && [ -f /tmp/screener-check/global/main.py ]; then \
        echo "Using existing .openops/screener from build context" && \
        mkdir -p /opt/screener && \
        cp -r /tmp/screener-check/* /opt/screener/; \
    else \
        echo "Cloning screener repos..." && \
        mkdir -p /opt/screener && \
        git clone --depth 1 https://github.com/aws-samples/service-screener-v2.git /opt/screener/global && \
        git clone --depth 1 https://github.com/lijh-aws-tools/service-screener-cn.git /opt/screener/china; \
    fi && rm -rf /tmp/screener-check

# Stage 3: Runtime image
FROM public.ecr.aws/docker/library/debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip jq git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 — auto-detect architecture (amd64→x86_64, arm64→aarch64)
RUN case "${TARGETARCH}" in \
      arm64) CLI_ARCH="aarch64" ;; \
      *)     CLI_ARCH="x86_64"  ;; \
    esac && \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${CLI_ARCH}.zip" -o awscliv2.zip \
    && unzip -q awscliv2.zip && ./aws/install && rm -rf aws awscliv2.zip

# uv (Python package manager) — install to /usr/local so non-root can use
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Copy screener & install Python deps
COPY --from=screener /opt/screener /app/.openops/screener
RUN cd /app/.openops/screener/global && uv venv \
    && uv pip install --python .venv/bin/python -r requirements.txt || true \
    && cd /app/.openops/screener/china && uv venv \
    && uv pip install --python .venv/bin/python -r requirements.txt || true

# Copy binary (from explicit path, not from cache mount)
COPY --from=builder /app/openops /usr/local/bin/openops

# Non-root user
RUN groupadd -r openops && useradd -r -g openops -s /sbin/nologin -d /app openops \
    && mkdir -p /app/workspace && chown -R openops:openops /app

USER openops
WORKDIR /app

EXPOSE 3080
ENV RUST_LOG=openops=info,tower_http=info

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:3080/health || exit 1

CMD ["openops"]

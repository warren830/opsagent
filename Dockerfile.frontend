# Ops Frontend - Multi-stage build (Nuxt SSR)

# Stage 1: Build Nuxt
FROM public.ecr.aws/docker/library/node:22-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --force

COPY frontend/ .
RUN npm run build

# Stage 2: Serve with Nitro (SSR)
FROM public.ecr.aws/docker/library/node:22-alpine

RUN addgroup -S ops && adduser -S -G ops -s /sbin/nologin ops

WORKDIR /app
COPY --from=builder --chown=ops:ops /app/.output .output

USER ops

EXPOSE 3000
ENV NITRO_PORT=3000
ENV NITRO_HOST=0.0.0.0

HEALTHCHECK --interval=15s --timeout=3s --start-period=8s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", ".output/server/index.mjs"]

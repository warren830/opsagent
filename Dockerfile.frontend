# Ops Frontend - Multi-stage build (Nuxt SSR)

# Stage 1: Build Nuxt
FROM public.ecr.aws/docker/library/node:22-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
# Use `npm install` (not `ci`) because the lockfile may reference platform-
# specific optional deps that only resolve at install time (rolldown / rollup
# / lightningcss all ship native binaries via optionalDependencies). `npm ci`
# would fail on the cross-platform diff; `npm install --omit=dev=false` keeps
# the deterministic install semantics we want without rejecting optional
# platform mismatches.
RUN npm install --no-audit --no-fund --legacy-peer-deps

COPY frontend/ .

# Set backend URL for Nuxt build — routeRules proxy target is compiled at build time.
# In EKS, the backend is reachable at http://ops-backend:3080 via K8s service DNS.
ARG NUXT_BACKEND_URL=http://backend:3080
ENV NUXT_BACKEND_URL=${NUXT_BACKEND_URL}

RUN npm run build

# Stage 2: Serve with Nitro (SSR)
FROM public.ecr.aws/docker/library/node:22-alpine

RUN addgroup -S ops && adduser -S -G ops -s /sbin/nologin ops

WORKDIR /app
COPY --from=builder --chown=ops:ops /app/.output .output

USER ops

EXPOSE 3000
ENV NITRO_PORT=3000
ENV NITRO_HOST=0.0.0.0

HEALTHCHECK --interval=15s --timeout=3s --start-period=8s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

CMD ["node", ".output/server/index.mjs"]

# ============================================================
# Ops Environment Configuration (local dev — port-shifted)
# ============================================================

OPS_ENV=local

# ── Database (mapped to host :5433 to avoid aws-cloudlens :5432) ──
DATABASE_URL=postgresql://ops:ops_dev@localhost:5433/ops

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=dev-secret-minimum-32-characters-long-change-in-prod

# ── Server ────────────────────────────────────────────────────
BACKEND_PORT=3080
FRONTEND_PORT=3100

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3100

# ── Claude Code ───────────────────────────────────────────────
CLAUDE_TIMEOUT_MS=300000
CLAUDE_MODEL=opus
CLAUDE_WORK_DIR=./workspace

# ── AWS ───────────────────────────────────────────────────────
AWS_PROFILE=default
AWS_REGION=us-east-1

# ── Logging ───────────────────────────────────────────────────
RUST_LOG=ops=debug,tower_http=debug

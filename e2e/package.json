{
  "name": "e2e",
  "version": "1.0.0",
  "description": "Playwright E2E + accessibility tests",
  "scripts": {
    "test": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:chromium": "playwright test --project=chromium",
    "test:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "install-browsers": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "@axe-core/playwright": "^4.10.0"
  }
}
